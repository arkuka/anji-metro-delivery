# Connect a PRIVATE Blob Store in Vercel Storage; token is server-only.
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=anji-delivery/production/v1
ADMIN_USERNAME=admin
ADMIN_PIN=
APP_TIMEZONE=Australia/Sydney
# Local development only: explicitly use a persistent local emulator.
# Never configure BLOB_LOCAL_DIR on Vercel.
# BLOB_LOCAL_DIR=/workspace/anji-delivery-local
